<?php

namespace models;

use core\Database;


class FormaPagamento
{

    private $db;

    public function __construct()
    {
        $this->db = Database::getConnection();
    }

    public function cadastrar($dados)
    {

        $sql = 'INSERT INTO formas_pagamento (nome, tipo, digito_cartao, apelido_cartao, usuario_criador, data_cadastro, usuario_editor, data_modificacao, deletada) VALUES (:nome, :tipo, :digito_cartao, :apelido_cartao, :usuario_criador, :data_cadastro, :usuario_editor, :data_modificacao, :deletada)';
        $sql = 'INSERT INTO formas_pagamento (nome, tipo, digito_cartao, apleido_cartao, usuario_criador, data_cadastro, usuario_editor, data_modificacao, deletada) 
                VALUES (:nome, :tipo, :digito_cartao, :apleido_cartao, :usuario_criador, :data_cadastro, :usuario_editor, :data_modificacao, :deletada)';

        $stmt = $this->db->prepare($sql);

        $stmt->bindValue(':nome', $dados->nome);
        $stmt->bindValue(':tipo', $dados->tipo);
        $stmt->bindValue(':digito_cartao', $dados->digito_cartao ?? null);
        $stmt->bindValue(':apelido_cartao', $dados->apleido_cartao ?? null);
        $stmt->bindValue(':usuario_criador', $dados->usuario_criador, \PDO::PARAM_INT);
        $stmt->bindValue(':data_cadastro', $dados->data_cadastro, \PDO::PARAM_INT);
        $stmt->bindValue(':usuario_editor', $dados->usuario_editor, \PDO::PARAM_INT);
        $stmt->bindValue(':data_modificacao', $dados->data_modificacao, \PDO::PARAM_INT);
        $stmt->bindValue(':deletada', isset($dados->deletada) ? (int)$dados->deletada : 0, \PDO::PARAM_INT);

        $stmt->execute();

        return $this->db->lastInsertId();
    }
    public function atualizar(int $id, $dados)
    {
        $sql = 'UPDATE formas_pagamento SET 
                    nome = :nome, 
                    digito_cartao = :digito_cartao, 
                    apleido_cartao = :apleido_cartao, 
                    usuario_editor = :usuario_editor, 
                    data_modificacao = :data_modificacao 
                WHERE id = :id';

        $stmt = $this->db->prepare($sql);
        $stmt->bindValue(':id', $id, \PDO::PARAM_INT);
        $stmt->bindValue(':nome', $dados->nome);
        $stmt->bindValue(':digito_cartao', $dados->digito_cartao ?? null);
        $stmt->bindValue(':apleido_cartao', $dados->apleido_cartao ?? null);
        $stmt->bindValue(':usuario_editor', $dados->usuario_editor);
        $stmt->bindValue(':data_modificacao', $dados->data_modificacao);

        return $stmt->execute();
    }

    public function remover($id)
    {
        $sql = 'UPDATE formas_pagamento SET deletada = 1 WHERE id = :id';

        $stmt = $this->db->prepare($sql);
        $stmt->bindValue(':id', $id, \PDO::PARAM_INT);

        return $stmt->execute();
    }

    public function listar()
    {
        $sql = 'SELECT * FROM formas_pagamento';
        $stmt = $this->db->prepare($sql);
        $stmt->execute();

        return $stmt->fetchAll(\PDO::FETCH_ASSOC);
    }
    public function detalhes($id)

    {
        $sql = 'SELECT * FROM formas_pagamento WHERE id = :id';

        $stmt = $this->db->prepare($sql);
        $stmt->bindValue(':id', $id, \PDO::PARAM_INT);
        $stmt->execute();

        return $stmt->fetch(\PDO::FETCH_ASSOC);
    }
}
